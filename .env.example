# ============================================================
#  Variables de entorno — Sistema de Control de Inventario
#  Constructora Del Valle S.A.
# ------------------------------------------------------------
#  Copie este archivo a .env y complete los valores reales.
#  NUNCA suba el archivo .env con credenciales al repositorio.
# ============================================================

# Cadena de conexion a la base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/inventario"

# Secreto para firmar las sesiones de autenticacion (NextAuth)
# Genere uno con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplace-con-un-secreto-aleatorio"
AUTH_SECRET="reemplace-con-un-secreto-aleatorio"

# URL base de la aplicacion (opcional en desarrollo)
# NEXTAUTH_URL="http://localhost:3000"
